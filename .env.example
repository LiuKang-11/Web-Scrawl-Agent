TARGET_URL="https://google.com"

# Choose one provider.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional login support.
LOGIN_USERNAME=""
LOGIN_PASSWORD=""
LOGIN_USERNAME_SELECTOR=""
LOGIN_PASSWORD_SELECTOR=""
LOGIN_SUBMIT_SELECTOR=""

# UiPath Automation Cloud / Orchestrator
UIPATH_BASE_URL="https://staging.uipath.com"
UIPATH_ORG_NAME="novasquard"
UIPATH_TENANT_NAME="DefaultTenant"
UIPATH_CLIENT_ID=""
UIPATH_CLIENT_SECRET=""
UIPATH_SCOPES=""

# Needed only when submitting an actual Orchestrator job.
UIPATH_FOLDER_ID=""
UIPATH_RELEASE_KEY=""

# FlowGuard runtime controls
FLOWGUARD_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
FLOWGUARD_CORS_ORIGIN_REGEX="^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$"
FLOWGUARD_ALLOW_LOCALHOST="true"
FLOWGUARD_ALLOW_PRIVATE_NETWORKS="false"
FLOWGUARD_ENABLE_AI_ANALYSIS="false"
FLOWGUARD_DB_PATH="data/flowguard.db"
